{
  "name": "sleightbook",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:with-api": "bun run --cwd apps/web dev:with-api",
    "db:seed": "bun run --cwd apps/api db:seed",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "test": "bun run --filter \"@sleightbook/*\" test",
    "test:e2e": "bun run --cwd apps/web test:e2e",
    "test:e2e:api": "bun run --cwd apps/web test:e2e:api",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run --filter \"@sleightbook/*\" typecheck",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2"
  }
}
